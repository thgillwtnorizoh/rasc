<Window x:Class="Rasc.Desktop.ClassicToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="240" Height="94" MinWidth="240" MinHeight="94" MaxWidth="240" MaxHeight="94"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowActivated="False" ShowInTaskbar="False" Focusable="False"
        Topmost="True" Background="Transparent" WindowStartupLocation="Manual"
        Title="RASC Classic achievement notification">
  <!-- 2023 VGUI nominal dimensions and color stops from P000. WPF DIP-to-VGUI
       physical scaling and border rasterization are NOT original-runtime verified. -->
  <Canvas Width="240" Height="94" ClipToBounds="True" IsHitTestVisible="False">
    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="240" Height="94">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#2A2E33" Offset="0"/>
          <GradientStop Color="#121A2A" Offset="0.851"/>
          <GradientStop Color="#121A2A" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- P000: DarkenedRegion extends to nominal y=97; clip behavior unknown.
         This first WPF profile bounds its painting to the 94-unit client panel. -->
    <Rectangle Canvas.Left="1" Canvas.Top="74" Width="238" Height="23" Fill="#121A2A"/>
    <!-- Border colors and pixel raster are provisional; the P000 source specifies
         procedural gradients/edges without a fully verified native screenshot. -->
    <Border Canvas.Left="0" Canvas.Top="0" Width="240" Height="94"
            BorderThickness="1" BorderBrush="#43536A"/>
    <Border Canvas.Left="13" Canvas.Top="13" Width="66" Height="66"
            BorderThickness="1" BorderBrush="#62748A"/>
    <Border Canvas.Left="14" Canvas.Top="14" Width="64" Height="64" Background="#183552">
      <TextBlock Text="★" Foreground="#C8D0DC" FontFamily="Arial"
                 FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Canvas.Left="88" Canvas.Top="25" Width="144" Height="28"
               Text="Achievement Unlocked!" Foreground="#C8D0DC"
               FontFamily="Arial" FontSize="12" FontWeight="ExtraBold"
               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="AchievementName" Canvas.Left="88" Canvas.Top="53"
               Width="144" Height="28" Foreground="#B4B4B4"
               FontFamily="Arial" FontSize="12" TextAlignment="Left"
               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
  </Canvas>
</Window>
