<Window x:Class="Rasc.Desktop.ClassicToastStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="240" Height="282"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowActivated="False" ShowInTaskbar="False" Focusable="False"
        Topmost="True" Background="Transparent"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        Title="RASC Classic notification stack">
  <!-- Single clipped 3x94 card composition viewport; no independent toast windows. -->
  <Canvas x:Name="Viewport" Width="240" Height="282"
          ClipToBounds="True" IsHitTestVisible="False"/>
</Window>
