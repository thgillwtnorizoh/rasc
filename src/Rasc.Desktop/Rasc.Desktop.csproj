<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Rasc.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rasc.Core/Rasc.Core.csproj" />
    <!-- Source PNGs supplied for experimental rare-glow fidelity verification.
         Asset redistribution/licensing is a separate OWNER acceptance gate. -->
    <Resource Include="Assets/SteamRareMasks/achievement_square_mask.png" />
    <Resource Include="Assets/SteamRareMasks/achievement_star_mask.png" />
  </ItemGroup>
</Project>
