<UserControl x:Class="Rasc.Desktop.ClassicToastCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240" Height="94" SnapsToDevicePixels="True"
             UseLayoutRounding="True" IsHitTestVisible="False"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Grayscale">
  <!-- Source anchor coordinates and colors: May 2023 Steam VGUI resources.
       OWNER TARGET: visually LEFT-aligned title/body, NO visible frame stroke.
       Original source title alignment=CENTER: discrepancy C-D08, not resolved.
       Font raster still NEEDS visual qualification; do not assert Steam parity. -->
  <Canvas Width="240" Height="94" ClipToBounds="True">
    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="240" Height="94">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#2A2E33" Offset="0"/>
          <GradientStop Color="#121A2A" Offset="0.851"/>
          <GradientStop Color="#121A2A" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- DarkenedRegion source y74+23 extends beyond panel94; clip in WPF. -->
    <Rectangle Canvas.Left="1" Canvas.Top="74" Width="238" Height="23"
               Fill="#121A2A"/>
    <!-- Original artifact/icon not licensed for redistribution: unframed placeholder. -->
    <Rectangle Canvas.Left="14" Canvas.Top="14" Width="64" Height="64" Fill="#343434"/>
    <TextBlock Canvas.Left="14" Canvas.Top="14" Width="64" Height="64"
               Text="★" Foreground="#B4B4B4" FontFamily="Arial"
               FontSize="28" FontWeight="Bold" TextAlignment="Center"
               VerticalAlignment="Center"/>
    <!-- OWNER VISUAL TARGET: Helvetica Regular, nominal 11.5 WPF DIPs and
         12.5-DIP line spacing estimated from BOTH reference screenshots.
         Windows may lack Helvetica: Arial is an explicit fallback only.
         ARCHIVED MAY 2023 SOURCE conflicts: FriendsSmall Arial tall12 weight800
         and centered title. Preserve C-D08/C-D09; GUI font raster unverified. -->
    <TextBlock x:Name="Headline" Canvas.Left="88" Canvas.Top="25"
               Width="144" Height="28" Foreground="#C8D0DC"
               FontFamily="Helvetica, Arial" FontSize="11.5" FontWeight="Normal"
               TextAlignment="Left" TextWrapping="Wrap"
               TextTrimming="None" LineStackingStrategy="BlockLineHeight"
               LineHeight="12.5"/>
    <TextBlock x:Name="Description" Canvas.Left="88" Canvas.Top="53"
               Width="144" Height="28" Foreground="#B4B4B4"
               FontFamily="Helvetica, Arial" FontSize="11.5" FontWeight="Normal"
               TextAlignment="Left" TextWrapping="Wrap"
               TextTrimming="None" LineStackingStrategy="BlockLineHeight"
               LineHeight="12.5"/>
  </Canvas>
</UserControl>
