<Window x:Class="Rasc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RASC — CS Virtual Achievements" Width="780" Height="570"
        MinWidth="570" MinHeight="430" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock FontSize="23" FontWeight="SemiBold" Text="CS Virtual Achievements"/>
      <TextBlock Margin="0,6,0,0" Foreground="Gray"
                 Text="Read-only local GC monitor · No Steam integration or game injection"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Margin="0,0,0,5" Text="GT-610 achievements.txt path" FontWeight="SemiBold"/>
        <TextBox x:Name="PathBox" Padding="8,6" MinHeight="32"
                 ToolTip="Choose csgo_gc\achievements.txt, not the Steam userdata folder."/>
      </StackPanel>
      <Button Grid.Column="1" Content="Browse..." Margin="10,23,0,0"
              Padding="14,5" MinWidth="93" Click="Browse_Click"/>
    </Grid>
    <StackPanel Grid.Row="4">
      <WrapPanel Orientation="Horizontal">
      <Button x:Name="StartButton" Content="Start monitoring" Padding="18,9"
              Click="Start_Click"/>
      <Button x:Name="StopButton" Content="Stop" IsEnabled="False"
              Margin="10,0,0,0" Padding="18,9" Click="Stop_Click"/>
      <TextBlock Text="Popup profile" Margin="18,0,7,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="ProfileBox" Width="105" VerticalAlignment="Center"
                SelectionChanged="ProfileBox_SelectionChanged"
                ToolTip="New events use the selected style. Existing popups finish first; the next style waits instead of overlapping windows.">
        <ComboBoxItem Content="Classic" Tag="Classic"/>
        <ComboBoxItem Content="Modern" Tag="Modern"/>
        <ComboBoxItem Content="Off" Tag="Off"/>
      </ComboBox>
      <Button x:Name="PreviewUnlockButton" Content="Preview Unlock" Margin="12,0,0,0" Padding="13,9"
              Click="PreviewClassic_Click"
              ToolTip="Uses the owner-supplied unlock screenshot text as a presentation-only fixture."/>
      <Button x:Name="PreviewRareButton" Content="Preview Rare" Margin="10,0,0,0" Padding="13,9"
              Click="PreviewRare_Click"
              ToolTip="Modern-only rare achievement golden-frame test; no GC or history changes."/>
      <Button x:Name="PreviewProgressButton" Content="Preview Progress" Margin="10,0,0,0" Padding="13,9"
              Click="PreviewProgress_Click"
              ToolTip="Shows a test progress notification only; GT-610 does not persist progress callbacks."/>
      </WrapPanel>
      <WrapPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Modern wave fixture" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="PreviewWaveCountBox" Width="74" SelectedIndex="2"
                  ToolTip="Presentation-only simultaneous wave: 1, 2, 3 or 6 awards. No GC or SQLite writes.">
          <ComboBoxItem Content="1 card" Tag="1"/>
          <ComboBoxItem Content="2 cards" Tag="2"/>
          <ComboBoxItem Content="3 cards" Tag="3"/>
          <ComboBoxItem Content="6 cards" Tag="6"/>
        </ComboBox>
        <Button x:Name="PreviewModernWaveButton" Content="Preview wave" Margin="10,0,0,0" Padding="12,5"
                Click="PreviewModernWave_Click"/>
      </WrapPanel>
      <WrapPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center" Text="Animation FPS" Margin="0,0,8,0"/>
        <ComboBox x:Name="AnimationFpsBox" Width="164" IsEditable="True" IsTextSearchEnabled="False"
                  SelectionChanged="AnimationFpsBox_SelectionChanged"
                  LostKeyboardFocus="AnimationFpsBox_LostKeyboardFocus"
                  KeyDown="AnimationFpsBox_KeyDown"
                  ToolTip="Display-synced or type any integer FPS from 15 to 240. A target controls average animation updates, not guaranteed displayed frames.">
          <ComboBoxItem Content="Display-synced" Tag="0"/>
          <ComboBoxItem Content="30 FPS cap" Tag="30"/>
          <ComboBoxItem Content="60 FPS cap" Tag="60"/>
          <ComboBoxItem Content="90 FPS cap" Tag="90"/>
          <ComboBoxItem Content="120 FPS cap" Tag="120"/>
          <ComboBoxItem Content="144 FPS cap" Tag="144"/>
          <ComboBoxItem Content="165 FPS cap" Tag="165"/>
          <ComboBoxItem Content="240 FPS cap" Tag="240"/>
        </ComboBox>
        <TextBlock VerticalAlignment="Center" Text="Popup size" Margin="22,0,8,0"/>
        <ComboBox x:Name="PopupSizeBox" Width="154" SelectionChanged="PopupSizeBox_SelectionChanged"
                  ToolTip="Auto adjusts for resolution and Windows DPI; manual percentages uniformly scale the accepted Classic design.">
          <ComboBoxItem Content="Auto (screen-aware)" Tag="0"/>
          <ComboBoxItem Content="100%" Tag="100"/>
          <ComboBoxItem Content="125%" Tag="125"/>
          <ComboBoxItem Content="150%" Tag="150"/>
          <ComboBoxItem Content="175%" Tag="175"/>
          <ComboBoxItem Content="200%" Tag="200"/>
          <ComboBoxItem Content="250%" Tag="250"/>
        </ComboBox>
      </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="SemiBold"
                 Text="Recorded unlock events (this companion's history)"/>
      <ListView Grid.Row="1" x:Name="RecentList">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Achievement ID" Width="380" DisplayMemberBinding="{Binding AchievementId}"/>
            <GridViewColumn Header="Observed (local)" Width="220" DisplayMemberBinding="{Binding Observed}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
    <StackPanel Grid.Row="7" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Idle — choose the GC file to begin."/>
      <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="Gray"
                 TextWrapping="Wrap"
                 Text="Existing achievements baseline silently. Choose Classic, Modern or Off; changing the profile affects new events only. FPS and sizing apply to both profiles. Previews never grant awards or modify the GC file/history."/>
    </StackPanel>
  </Grid>
</Window>
