<Window x:Class="Rasc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RASC — CS Virtual Achievements" Width="780" Height="570"
        MinWidth="570" MinHeight="430" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock FontSize="23" FontWeight="SemiBold" Text="CS Virtual Achievements"/>
      <TextBlock Margin="0,6,0,0" Foreground="Gray"
                 Text="Read-only local GC monitor · No Steam integration or game injection"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Margin="0,0,0,5" Text="GT-610 achievements.txt path" FontWeight="SemiBold"/>
        <TextBox x:Name="PathBox" Padding="8,6" MinHeight="32"
                 ToolTip="Choose csgo_gc\achievements.txt, not the Steam userdata folder."/>
      </StackPanel>
      <Button Grid.Column="1" Content="Browse..." Margin="10,23,0,0"
              Padding="14,5" MinWidth="93" Click="Browse_Click"/>
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal">
      <Button x:Name="StartButton" Content="Start monitoring" Padding="18,9"
              Click="Start_Click"/>
      <Button x:Name="StopButton" Content="Stop" IsEnabled="False"
              Margin="10,0,0,0" Padding="18,9" Click="Stop_Click"/>
      <CheckBox x:Name="ClassicPopupsCheck" Content="Classic popups" IsChecked="True"
                Margin="18,0,0,0" VerticalAlignment="Center"/>
      <Button Content="Preview Classic" Margin="12,0,0,0" Padding="13,9"
              Click="PreviewClassic_Click"
              ToolTip="Shows a local test popup; does not unlock anything or write to history."/>
    </StackPanel>
    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="SemiBold"
                 Text="Recorded unlock events (this companion's history)"/>
      <ListView Grid.Row="1" x:Name="RecentList">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Achievement ID" Width="380" DisplayMemberBinding="{Binding AchievementId}"/>
            <GridViewColumn Header="Observed (local)" Width="220" DisplayMemberBinding="{Binding Observed}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>
    <StackPanel Grid.Row="7" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Idle — choose the GC file to begin."/>
      <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="Gray"
                 TextWrapping="Wrap"
                 Text="On first monitoring, existing achievements become the baseline without new popups. Missing or malformed files never erase the checkpoint. Classic desktop popups are an unverified P002 preview; Modern, original assets, audio, and exact native motion remain future work."/>
    </StackPanel>
  </Grid>
</Window>
