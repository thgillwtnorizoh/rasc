<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Keep native SQLite above the vulnerable 2.1.11 transitive dependency. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same plain CSV is embedded for zero-setup fallback and copied beside
         the application so owners can edit rarity without recompiling. -->
    <EmbeddedResource Include="Data/achievement-definitions.v0.2.csv"
                      LogicalName="Rasc.Core.Data.achievement-definitions.v0.2.csv" />
    <None Update="Data/achievement-definitions.v0.2.csv"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
